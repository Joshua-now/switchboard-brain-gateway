# -- SwitchBoard Brain Gateway -- environment --------------------------------

# The product Hermes brain, over Railway's PRIVATE network (same project).
# Find the exact host on the brain service -> Settings -> Networking -> Private.
HERMES_URL=http://hermes-agent.railway.internal:8642

# The brain's API_SERVER_KEY (so the gateway can call it).
HERMES_API_KEY=

# Bearer token Telnyx must present to call this gateway. Make up a long random
# string; set the SAME value as the custom-LLM API key on each Telnyx assistant.
GATEWAY_API_KEY=

# Comma-separated tenant ids allowed to use the gateway. Empty = deny all
# (fail closed). For the first test, put your test tenant id here, e.g. test123
ALLOWED_TENANTS=

# How long to wait on the brain before returning a holding line (ms). Voice-tuned.
BRAIN_DEADLINE_MS=18000

# What the caller hears if the brain is slow/errors (never dead air).
HOLDING_LINE=Give me just one second.

# Railway sets PORT automatically; leave unset locally to default to 3000.
# PORT=3000
